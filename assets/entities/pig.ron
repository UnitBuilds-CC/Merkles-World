// Pig entity definition (Phase 2 vertical slice)
// Full EntityDef wrapper with transform and state metadata.
//
// Proportions are driven by what the viewport shows, not by the numbers: see
// `cargo run -p editor --example render_png`, which dumps the marched silhouette from six angles.
// The grammar has no translate node (OQ-55), so every placed part is a sphere and the only primitive
// that may sit at the origin is `RoundedBox`.
//
// What the renders rejected, in order:
// - `RoundedBox(half: (0.22, 0.18, 0.34), r: 0.15)` — a rounded box spans `2 * (half + r)`, so this was
//   a 0.74 x 0.66 x 0.98 slab, not the 0.44 x 0.36 body the fields read as.
// - `RoundedBox(half: (0.13, 0.15, 0.32), r: 0.13)` — collapsing the rounding in X still leaves the side
//   profile a rounded rectangle: flat back, flat belly. A loaf, not an animal.
// - Two torso spheres smoothed at `k` equal to their separation merged into one egg, and a single-sphere
//   head the same height as that egg read as a snowman.
// - Hard `Union` between overlapping spheres: a cluster of balloons with a V-notch at every join, because
//   a plain union takes the minimum and keeps the crease.
// - One sphere per leg read as a ball under the belly, and a head joined at the body's own height read
//   as a hump on the back rather than a head.
// - The first sphere-only pass read as a hippo: three fat body spheres as tall as they were long, legs
//   that were two wide balls each sitting directly under a belly that nearly touched the floor, and a
//   head the size of the torso merged into the chest. The `low` view made it unmistakable — four teats
//   under a ball, not four legs under an animal.
//
// So the corrective pass is proportion, not new parts: the body is spread along Z so it is longer than
// tall and lifted so its belly clears the ground; each leg is a thin thigh and a thinner hoof reaching
// well below the belly; the head is smaller than the torso and raised onto a neck thinner than both;
// and every join is still a smooth union with `k` well under the overlap so it reads as flesh, not a
// cluster.
//
// Hypothesis for docs/04, not a measurement: every blended join is a place the marcher cannot skip,
// since ADR-024's k-aware skip refuses exactly the large-`k` case, so an authored creature is an R1
// expense per part. Nothing here controls for that yet — the debug CPU raster's timings swing by more
// than the effect under machine load, so the claim stays a hypothesis until someone times a hard-union
// twin of this tree.

EntityDef(
    shape: SmoothUnion(
        // Tail and ears, blended into the rump and head so they read as growths, not floating balls.
        k: 0.04,
        a: SmoothUnion(
            // Legs, blended into the body at the shoulder and hip.
            k: 0.05,
            a: SmoothUnion(
                k: 0.06,
                a: SmoothUnion(
                    // Body: rump and chest either side of a mid sphere lifted to arch the back. Spread
                    // along Z so the torso is longer than it is tall, and raised so the belly clears
                    // the floor the legs stand on.
                    k: 0.12,
                    a: Sphere(
                        r: 0.24,
                        centre: (0.0, 0.15, 0.28),
                    ),
                    b: SmoothUnion(
                        k: 0.12,
                        a: Sphere(
                            r: 0.23,
                            centre: (0.0, 0.17, 0.04),
                        ),
                        b: Sphere(
                            r: 0.20,
                            centre: (0.0, 0.14, -0.20),
                        ),
                    ),
                ),
                b: SmoothUnion(
                    // Neck into head into snout: the neck is thinner and lower than the head, which is
                    // what makes the head read as a head and not a hump on the back.
                    k: 0.05,
                    a: Sphere(
                        r: 0.13,
                        centre: (0.0, 0.17, -0.36),
                    ),
                    b: SmoothUnion(
                        k: 0.05,
                        a: Sphere(
                            r: 0.18,
                            centre: (0.0, 0.19, -0.54),
                        ),
                        b: Subtract(
                            // Snout: two spheres smoothed sideways, because a single sphere reads as a
                            // muzzle and a pig's is a disc wider than it is tall. Nostrils cut into its
                            // front face.
                            kept: SmoothUnion(
                                k: 0.04,
                                a: Sphere(
                                    r: 0.075,
                                    centre: (0.06, 0.12, -0.70),
                                ),
                                b: Sphere(
                                    r: 0.075,
                                    centre: (-0.06, 0.12, -0.70),
                                ),
                            ),
                            cutter: Union(
                                a: Sphere(
                                    r: 0.018,
                                    centre: (0.045, 0.12, -0.765),
                                ),
                                b: Sphere(
                                    r: 0.018,
                                    centre: (-0.045, 0.12, -0.765),
                                ),
                            ),
                        ),
                    ),
                ),
            ),
            b: Mirror(
                // Two authored legs — each a thin thigh and a thinner hoof smoothed into a column —
                // mirrored about X into four. They reach well below the belly, which is what makes the
                // animal stand instead of rest on the ground.
                axis: 0,
                child: Union(
                    a: SmoothUnion(
                        // Front leg: the thigh sits inside the chest and the hoof overlaps it, so the
                        // column is continuous from belly to floor. A hoof that only touches the thigh
                        // reads as a detached ball once `k` is smaller than the gap between them.
                        k: 0.06,
                        a: Sphere(
                            r: 0.095,
                            centre: (0.13, 0.02, -0.18),
                        ),
                        b: Sphere(
                            r: 0.08,
                            centre: (0.13, -0.14, -0.18),
                        ),
                    ),
                    b: SmoothUnion(
                        // Back leg: same, under the rump, a touch thicker to carry the haunch.
                        k: 0.06,
                        a: Sphere(
                            r: 0.10,
                            centre: (0.13, 0.02, 0.30),
                        ),
                        b: Sphere(
                            r: 0.085,
                            centre: (0.13, -0.15, 0.30),
                        ),
                    ),
                ),
            ),
        ),
        b: Union(
            // Tail and ears: neither pair touches, so a hard union between them costs nothing, and the
            // root's `k` is what blends each of them into the body and head.
            a: Sphere(
                r: 0.04,
                centre: (0.0, 0.26, 0.50),
            ),
            b: Union(
                a: Sphere(
                    r: 0.06,
                    centre: (0.10, 0.34, -0.48),
                ),
                b: Sphere(
                    r: 0.06,
                    centre: (-0.10, 0.34, -0.48),
                ),
            ),
        ),
    ),
    position: (0.0, 0.0, 0.0),
    rotation: (0.0, 0.0, 0.0, 1.0),
    scale: 1.0,
    material_id: 0, // pig_skin slot
    flags: 3,       // ALIVE | ACTIVE
    quantity: 0,
)
